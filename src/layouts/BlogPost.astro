---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"] & { id?: string };
const { title, description, pubDate, updatedDate, heroImage, project } =
  Astro.props;
---

<BaseLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  image={heroImage?.src}
>
  <article class="site-container section case-study">
    <a href="/blog/" class="text-link back-link">
      <span aria-hidden="true">←</span> All Case Studies
    </a>
    <header class="article-header">
      <p class="eyebrow">{project?.category ?? "Case Study"}</p>
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      <div class="article-meta">
        {project && <p>{project.role}</p>}
        <p>
          {updatedDate ? "Updated " : "Published "}
          <FormattedDate date={updatedDate ?? pubDate} />
        </p>
      </div>
      {project && (
        <ul class="tags" aria-label="Technologies and focus">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>
    {heroImage && (
      <div class="article-visual">
        <ProjectVisual
          image={heroImage}
          name={project?.name ?? title}
          theme={project?.theme}
        />
      </div>
    )}
    <div class="case-study-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    max-width: 840px;
  }
  .back-link {
    margin-bottom: 2.5rem;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 4rem);
  }
  .article-description {
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.2rem;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-block: 1.5rem;
    font-size: 0.8rem;
  }
  .article-meta p {
    margin: 0;
    color: var(--color-muted);
  }
  .article-meta p:first-child {
    color: var(--color-body);
  }
  .article-visual {
    margin-block: 2.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .case-study-content {
    max-width: 720px;
    margin-inline: auto;
    font-size: 1.05rem;
  }
  .case-study-content :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.7rem;
  }
  .case-study-content :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.3rem;
  }
  .case-study-content :global(p),
  .case-study-content :global(li) {
    color: var(--color-muted);
  }
  .case-study-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .case-study-content :global(ul),
  .case-study-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }
  .case-study-content :global(ul) {
    list-style: disc;
  }
  .case-study-content :global(ol) {
    list-style: decimal;
  }
  .case-study-content :global(li) {
    margin-bottom: 0.6rem;
    padding-left: 0.25rem;
  }
  .case-study-content :global(a) {
    text-decoration: underline;
  }
</style>
