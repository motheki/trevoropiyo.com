---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main
			transition:animate="slide"
			class="w-[960px]! max-w-[calc(100%-2em)] mx-auto py-12 px-4"
		>
			<section>
				<ul class="flex flex-wrap gap-8 list-none m-0 p-0">
					{
						posts.map((post, i) => (
							<li
								class:list={[
									"rounded-xl transition-transform duration-200 hover:-translate-y-1",
									i === 0
										? "w-full mb-4 text-center"
										: "w-[calc(50%-1rem)]",
								]}
								style="box-shadow: none"
								onmouseover="this.style.boxShadow='var(--box-shadow)'"
								onmouseout="this.style.boxShadow='none'"
							>
								<a href={`/blog/${post.id}/`} class="block no-underline">
									<Image
										transition:name={"hero-" + post.id}
										width={i === 0 ? 960 : 720}
										height={i === 0 ? 480 : 360}
										src={post.data.heroImage ?? "/big-bend.png"}
										alt={post.data.title}
										class:list={["mb-2 rounded-xl", i === 0 && "w-full"]}
									/>
									<h4
										transition:name={"title-" + post.id}
										class:list={[
											"m-0 text-body leading-none",
											i === 0 ? "text-[2.369rem]" : "",
										]}
									>
										{post.data.title}
									</h4>
									<p class="m-0 text-muted">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
