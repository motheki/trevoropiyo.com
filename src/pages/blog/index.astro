---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) =>
    (a.data.project?.order ?? Infinity) - (b.data.project?.order ?? Infinity) ||
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title={`Case Studies | ${SITE_TITLE}`}
  description="Selected software projects by Trevor Opiyo: AthletIQ, USBN, Super HN, and Ambiance. Mobile engineering, web applications, and product delivery."
>
  <div class="site-container section">
    <div class="section-heading">
      <p class="eyebrow">The Work, in Detail</p>
      <h1>Selected Projects.</h1>
      <p>
        Product context, engineering decisions, and delivery across basketball
        technology, football data, and the web.
      </p>
    </div>
    <section class="project-grid" aria-label="Project case studies">
      {posts.map((post) => (
        <ProjectCard post={post} headingLevel="h2" />
      ))}
    </section>
  </div>
</BaseLayout>
