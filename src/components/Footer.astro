---
import { LINKEDIN_URL } from "../consts";
const year = new Date().getFullYear();
---

<footer>
  <div class="site-container footer-inner">
    <div>
      <p class="footer-name">Trevor Opiyo LLC</p>
      <p class="copyright">&copy; {year} · Software, from scope to release.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href={LINKEDIN_URL}>
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a href="https://github.com/motheki">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .footer-name {
    margin: 0 0 0.25rem;
    font-weight: 600;
  }
  .copyright {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.4rem;
    color: var(--color-muted);
    font-size: 0.85rem;
    text-decoration: none;
  }
</style>
