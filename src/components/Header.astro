---
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import companyLogo from "../images/trevor-opiyo-llc-logo.webp";
---

<header class="site-header">
  <nav class="site-container navigation" aria-label="Main navigation">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>
      <Image
        src={companyLogo}
        alt=""
        width={96}
        height={96}
        loading="eager"
        class="brand-logo"
      />
      <span>
        Trevor Opiyo<span class="brand-caption">Software Developer</span>
      </span>
    </a>
    <div class="nav-links">
      <HeaderLink href="/#work">Work</HeaderLink>
      <HeaderLink href="/#services">Expertise</HeaderLink>
      <HeaderLink href="/#experience">Experience</HeaderLink>
      <HeaderLink href="/blog/">Case Studies</HeaderLink>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(8, 15, 28, 0.96);
  }
  .navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 88px;
  }
  .brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-body);
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }
  .brand:hover {
    color: var(--color-pine);
  }
  .brand-logo {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .brand-caption {
    display: block;
    margin-top: 0.15rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: 400;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  @media (max-width: 860px) {
    .navigation {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      padding-block: 0.75rem 0.35rem;
    }
    .nav-links {
      order: 3;
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (max-width: 380px) {
    .brand-logo {
      width: 36px;
      height: 36px;
    }
    .brand {
      gap: 0.5rem;
      font-size: 0.9rem;
    }
  }
</style>
