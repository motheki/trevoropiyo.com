---
import { Image } from "astro:assets";
import { LINKEDIN_URL, SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import companyLogo from "../images/trevor-opiyo-llc-logo.png";
---

<header
  transition:persist
  class="sticky top-0 z-50 m-0 border-b border-[rgba(99,215,255,0.16)] bg-[rgba(2,8,20,0.86)] px-4 py-3 shadow-[0_16px_40px_rgba(0,0,0,0.24)] backdrop-blur-xl"
>
  <nav class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-3">
    <h2 class="m-0 text-[1em]">
      <a
        href="/"
        class="flex items-center gap-3 text-[#f5f9ff] no-underline hover:text-pine"
      >
        <Image
          src={companyLogo}
          alt=""
          width={144}
          height={144}
          class="h-[72px] w-[72px] rounded-lg border border-[rgba(99,215,255,0.42)] object-contain shadow-[0_0_18px_rgba(36,183,255,0.18)]"
        />
        <span class="text-lg font-black text-[#f5f9ff] drop-shadow-[0_1px_10px_rgba(99,215,255,0.22)]">
          {SITE_TITLE}
        </span>
      </a>
    </h2>
    <div class="flex flex-wrap items-center justify-center gap-1">
      <HeaderLink href="/#services">Services</HeaderLink>
      <HeaderLink href="/#work">Work</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/#contact">Contact</HeaderLink>
    </div>
    <a
      href={LINKEDIN_URL}
      target="_blank"
      rel="noreferrer"
      class="rounded-full border border-[rgba(99,215,255,0.28)] px-4 py-2 text-sm font-bold text-body no-underline transition hover:border-pine hover:bg-[rgba(36,183,255,0.12)]"
    >
      LinkedIn
    </a>
  </nav>
</header>
