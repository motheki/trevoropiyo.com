---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE_TITLE } from "../consts";

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = "/big-bend.png" } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<script is:inline>
	(function() {
		const stored = localStorage.getItem("theme") || "auto";
		let effectiveTheme;
		
		if (stored === "auto") {
			// Respect browser preference
			effectiveTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
		} else if (stored === "dark" || stored === "light") {
			effectiveTheme = stored;
		} else {
			// Fallback to browser preference if invalid value
			effectiveTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
		}
		
		document.documentElement.setAttribute("data-theme", effectiveTheme);
	})();
</script>
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="me" href="https://mastodon.social/@trevoropiyo">

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<ClientRouter />

