---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-block no-underline px-2 py-4 text-body hover:text-pine",
    className,
  ]}
  {...props}
>
  <slot />
</a>
