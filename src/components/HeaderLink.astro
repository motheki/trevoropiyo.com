---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center rounded-full px-3 py-2 text-sm font-semibold text-muted no-underline transition hover:bg-overlay hover:text-body",
    className,
  ]}
  {...props}
>
  <slot />
</a>
